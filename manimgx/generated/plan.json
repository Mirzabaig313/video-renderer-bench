 "captions": [
  {
   "start_ms": 420,
   "end_ms": 3230,
   "lines": [
    "What happens to a message",
    "if the consumer crashes?"
   ]
  },
  {
   "start_ms": 4155,
   "end_ms": 8480,
   "lines": [
    "A producer sends messages to a broker,",
    "and a consumer takes them off the queue."
   ]
  },
  {
   "start_ms": 8806,
   "end_ms": 9899,
   "lines": [
    "Orders stream in."
   ]
  },
  {
   "start_ms": 9973,
   "end_ms": 11789,
   "lines": [
    "The queue fills, then drains."
   ]
  },
  {
   "start_ms": 12106,
   "end_ms": 13781,
   "lines": [
    "Then the consumer crashes."
   ]
  },
  {
   "start_ms": 14700,
   "end_ms": 17481,
   "lines": [
    "Inside the broker,",
    "the message is not deleted."
   ]
  },
  {
   "start_ms": 17568,
   "end_ms": 19195,
   "lines": [
    "It waits, unacknowledged."
   ]
  },
  {
   "start_ms": 20125,
   "end_ms": 24308,
   "lines": [
    "Consumers acknowledge only after",
    "the work is done, with channel.ack."
   ]
  },
  {
   "start_ms": 24641,
   "end_ms": 27874,
   "lines": [
    "When the consumer recovers,",
    "the broker redelivers the message,"
   ]
  },
  {
   "start_ms": 27874,
   "end_ms": 29713,
   "lines": [
    "and this time it is acknowledged."
   ]
  },
  {
   "start_ms": 30040,
   "end_ms": 31097,
   "lines": [
    "Nothing is lost."
   ]
  },
  {
   "start_ms": 31176,
   "end_ms": 34374,
   "lines": [
    "Ack after the work,",
    "and every message survives a crash."
   ]
  }
 ],
